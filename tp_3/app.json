{
  "expo": {
    "name": "iBank",
    "slug": "ibank-supabase-auth",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ibanktp",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0A0F1D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ibank.authapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0F1D"
      },
      "package": "com.ibank.authapp",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
